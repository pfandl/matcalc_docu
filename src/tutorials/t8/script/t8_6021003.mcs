set-plot-option plot-id=. series lock series-index=-1 series-name=T$C do-lock=yes               $ Locking the last series
set-plot-option plot-id=. series rename series-index=-1 series-name=*_T$C new-name=graphite     $ Renaming series: "*_T$C" --> "graphite"


$------------------------------------- The finished diagram ---------------------------------------$
set-plot-option plot-id=. plot-title=Fe-C phase diagram                                         $ Plot title
set-plot-option plot-id=. y-axis-title=Temperature [C]                                          $ y-axis title
$ Scaling of y-axis starts from "400"
set-plot-option plot-id=. y-axis-scaling=400..


$$************************************************************************************************** 
                                       SAVING WORKSPACE
**************************************************************************************************$$

$save-workspace "file-name"=Tutorial_8
