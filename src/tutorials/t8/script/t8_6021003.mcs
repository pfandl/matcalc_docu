set-plot-option plot-id=. series rename series-index=-1 series-name=*_T$C new-name=bcc_low      $ Renaming series: "*_T$C" --> "bcc_low"


$--------------------------------- Lower boundary of austenite ------------------------------------$
set-temperature-celsius temperature=700                                                         $ Temperature 700C
calculate-equilibrium
search-phase-boundary phase-name=FCC_A1 temperature                                             $ Varying temperature for the phase boundary search

set-step-option type=phase-boundary                                                             $ "Phase boundary" type
