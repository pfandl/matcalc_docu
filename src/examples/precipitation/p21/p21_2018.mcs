
$$************************************************************************************************** 
************************************** GENERAL INFORMATION *****************************************
****************************************************************************************************

A more complex precipitation system compared to P20 was selected for this example. This example 
features the simultaneous precipitation of two different precipitates. It is important to mention,
that every element needs a phase where it can nucleate. Therefore Cu2s was chosen for the copper,
and MnS_Q for the sulfur. If an element has no phase where it can be, massive errors can occur
(e.g.: liquid phase becomes stable at 300C, etc...).

This example starts with a Scheil calculation to determine the phase fractions of both precipitates.
It then continues with the virtual treatment to set up the primary precipitates. 


Database: mc_fe.tdb, mc_fe.ddb
Author: G. Stechauner
Creation date: 2011-12-16
This is a script for MatCalc version 5.44 (rel 1.002)


**************************************************************************************************** 
************************************** SETUP INFORMATION *******************************************
**************************************************************************************************$$

$ make sure we work in the correct module
use-module core            $ select core module for kinetic simulation

$ close any open workspace without asking for save
close-workspace f

new-workspace              $ open new workspace

@ echo n
set-workspace-info + Dealing with multiple primary precipitates
set-workspace-info +
set-workspace-info + Phases: FCC_A1, BCC_A2, Cementite, AlN, Cu2S, MnS_Q
set-workspace-info + Chemical components: Fe, Al, C, Cu, Mn, N, Nb, S, Si, Ti
set-workspace-info + 
set-workspace-info + For further information visit www.matcalc.at
set-workspace-info +
echo y


$$************************************************************************************************** 
**************************************** SYSTEM SETUP **********************************************
**************************************************************************************************$$

$ verify correct MatCalc version (is accessible as internal variable) 
if (matcalc_version<5441002)
   send-dialog-string "MatCalc version must be 5.44.1002 or higher to run this script. Stopping."
   stop_run_script                                         $ stop script
endif


$ ************************************************************************************************** 
$ ************************ DATABASES, CHEMICAL COMPOSITION, SELECTED PHASES ************************
$ **************************************************************************************************

open-thermodyn-database mc_x_FeAlCCuMnNNbSSiTi.tdb   $ Thermodynamic database
select-elements Fe Al C Cu Mn N Nb S Si Ti                    $ select elements
select-phase AlN bcc_a2 fcc_a1 cementite Cu2S MnS_Q           $ select phases

read-thermodyn-database                                       $ read thermodynamic database
read-mobility-database mc_fe.ddb                       $ read diffusion data

enter-composition wp al=0.03 C=0.4 Cu=0.05 Mn=0.5 N=0.01 Nb=0.035 S=0.01 Si=0.3 Ti=0.01

$ ************************************************************************************************** 
$ *********************************** CHANGE PHASE STATUS ETC. *************************************
$ **************************************************************************************************

change-phase-status fcc_a1#01 m :FE:VA:                       $ Change complex phase to equil phase

$ Create compositions sets for TiN and NbC
create-new-phase fcc_a1 c :NB%,TI:C%,N,VA%: NbC
create-new-phase fcc_a1 c :TI%,NB:N%,C,VA%: TiN

$ make sure that the major constituents of TiN and NbC are enforced !!! Otherwise these
$ two phases can become mixed up between each other
change-phase-status NbC f e s                                       $ enforce major constituents
change-phase-status TiN f e s                                       $ enforce major constituents

create-precipitation-domain virtual                                 $ Precipitationdomain for virtual Heat Treatment
set-precipitation-parameter virtual x fcc_a1#01                     $ matrix phase of domain heat-treatment
set-precipitation-parameter virtual T D E 1e12                      $ Equil. dislocation density


$ ------------------------- PRECIPITATE PHASES IN virtualENITE ------------------------------------

create-new-phase TiN p TiN(virtual)                             $ create new precipitate phase 
set-precipitation-parameter TiN_p0 c 25                         $ number of prec. classes
set-precipitation-parameter TiN_p0 n j y                        $ nucleation only with valid parent major constituents
set-precipitation-parameter TiN_p0 n s e                        $ nucleation sites are grain boundary edges
set-precipitation-parameter TiN_p0 n p y virtual                $ restrict nucleation domain
set-precipitation-parameter TiN_p0 n u 7e-2                     $ nucleation constant
set-precipitation-parameter TiN_p0 s m s 0.5                    $ diffusion enhancement

create-new-phase MnS_Q p MnS(virtual)
set-precipitation-parameter MnS_Q_p0 c 25                       $ number of prec. classes
set-precipitation-parameter MnS_Q_p0 n j y                      $ nucleation only with valid parent major constituents
set-precipitation-parameter MnS_Q_p0 n s d                      $ nucleation sites are dislocations
set-precipitation-parameter MnS_Q_p0 n p y virtual              $ restrict nucleation domain


$$**************************************************************************************************
************************************ OUTPUT WINDOWS, PLOTS, ETC. ***********************************
**************************************************************************************************$$

$ ------------------------- Temperature, phase-fraction, radius, density ---------------------------

new-gui-window p1                                               $ generate new plot: temperature
                                                                                                                                                                                                                                                                                                                      $ Define values for default x-axis (will be used by all plots)
$remember window ID to address it correctly later in the script
set-variable-value buffer_window_id active_frame_id             $ assign to variable ...

set-gui-window-property . x stepvalue                           $ default x-axis variable (time)
set-gui-window-property . s u y                                 $ use default x-axis for all plots: yes
set-gui-window-property . s t time / s                          $ default x-axis title                    
set-gui-window-property . s f 1                                 $ scaling factor is 1
set-gui-window-property . n 2                                   $ 2 plot columns
set-gui-window-property . s y log                               $ Set x-Axis to log

set-plot-option . s n b t$c                                     $ add series: temperature
set-plot-option . s m -1 t$c T                                  $ rename series
set-plot-option . a y 1 t temperature / C                       $ y-axis title
set-plot-option . l n                                           $ no legend

create-new-plot x .                                             $ create new plot: phase fractions
set-plot-option . l a y                                         $ replace all variable names by kinetic alias names
set-plot-option . s n b f_prec$*                                $ add all series: phase fractions of precipitates
set-plot-option . a y 1 t phase fraction                        $ change y-axis title
set-plot-option . a y 1 y log                                   $ use logarithmic scale for y-axis
$set-plot-option . a y 1 s 1e-8..1                              $ scale the y-axis from 1e-8..1
set-plot-option . l b                                           $ show legend at the bottom of the figure

create-new-plot x .                                             $ create new plot: number densities
set-plot-option . l a y                                         $ replace all variable names by kinetic alias names
set-plot-option . s n b num_part$*                              $ add all series: number densities of precipitates
set-plot-option . a y 1 t number density / m<sup>-3</sup>       $ change y-axis title
set-plot-option . a y 1 y log                                   $ use logarithmic scale for y-axis
set-plot-option . a y 1 s 1e10..5e12                            $ scale the y-axis 
set-plot-option . l b                                           $ show legend at the bottom of the figure

create-new-plot x .                                             $ create new plot: mean radii
set-plot-option . l a y                                         $ replace all variable names by kinetic alias names
set-plot-option . s n b r_mean$*                                $ add all series: mean radii of precipitates
set-plot-option . a y 1 t mean radius / nm                      $ change y-axis title
set-plot-option . a y 1 y log                                   $ use logarithmic scale for y-axis
set-plot-option . a y 1 f 1e9                                   $ scaling factor is 1e9
set-plot-option . a y 1 s 0.1..                                 $ scale the y-axis 
set-plot-option . l b                                           $ show legend at the bottom of the figure

move-gui-window . 50 10 700 950                                 $ move window to new position and resize
update-gui-window .                                             $ update the GUI window

$ ------------------------------------------ Histogramm --------------------------------------------

new-gui-window p5                             $ new precipitation distribution plot window, scaled version
set-plot-option . l a y                       $ replace all variable names by kinetic alias names
set-plot-option . s n p TiN_p0                $ add series
set-plot-option . s n p MnS_Q_p0              $ add series
set-plot-option . a x 1 f 1e9                 $ use scaling factor 1e9 for x-axis
set-plot-option . a y 1 s 1e10..1e13          $ scale the y-axis from 1e10..1e22
set-plot-option . a y 1 y log                 $ use logarithmic scale for y-axis
set-plot-option . a x 1 t radius / nm         $ change x-axis title
set-plot-option . a x 1 y log                 $ use logarithmic scale for x-axis
set-plot-option . a y 1 t number density      $ change y-axis title

move-gui-window . 505 100 450 400             $ move window to new position and resize
update-gui-window .                           $ Update the GUI window     

$ bring output window to front ...
move-gui-window 0 25 50 750 740               $ move output window to new position and resize
move-gui-window 0 hide                        $ first 'hide' to be able to ...
move-gui-window 0 show                        $ ... bring output window to front


$$***************************************************************************************************
******************************************** HEAT TREATMENT *****************************************
***************************************************************************************************$$

$-------------------------------------- Virtual heat treatment -------------------------------------$

create-heat-treatment virtual                 $ create new heat treatment
append-ht-segment virtual                     $ append new segment
edit-ht-segment virtual . d n virtual         $ define precipitation domain
edit-ht-segment virtual . s 800               $ define start temperature
edit-ht-segment virtual . 2 0 1               $ Heat rate + delta Time

append-ht-segment virtual                     $ append new segment
edit-ht-segment virtual . 1 1402 100          $ End temp + Heat rate

append-ht-segment virtual                     $ append new segment
edit-ht-segment virtual . 2 0 1e6             $ Heat Rate + delta Time

$$**************************************************************************************************
********************************** START PRECIPITATE SIMULATION ************************************
**************************************************************************************************$$

set-temperature-celsius 800                              $ define something
set-automatic-startvalues                                $ initiate equilibrium calculation 
calc-equilibrium                                         $ calculate equilibrium state

set-simulation-parameter u 100

rename-current-buffer virtual                            $ rename buffer for heat treatment 
set-gui-window-property buffer_window_id b virtual       $ attach to buffer window
set-simulation-parameter t h virtual 10                  $ temperature profile from HT, max. T-step
set-simulation-parameter s r                             $ starting condition for prec. sim.: reset

start-precipitate-simulation                             $ let's go!

$ save state after simulation. This is the starting point for next simulation: 
create-calc-state after-virtual                          $ create calc state 


$$**************************************************************************************************
****************************************** END OF P20_1 ********************************************
**************************************************************************************************$$