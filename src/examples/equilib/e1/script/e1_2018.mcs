$ In the active[.] GUI-window, all unlocked series will be duplicated and [l]ocked
set-gui-window-property . L
$ Renaming series: "*_T$C" --> "bcc_high_1"
set-plot-option . S M -1 *_T$C bcc_high_1


$---------------------------------- Lower boundary of liquid --------------------------------------$
