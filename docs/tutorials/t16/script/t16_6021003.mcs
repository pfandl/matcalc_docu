$$************************************************************************************************** 
************************************** GENERAL INFORMATION *****************************************
****************************************************************************************************

Script for effect of microstructure and conditions (Part 2) according to Tutorial 16.
The following contents will be covered:

 - Simultaneous precipitation of two phases
 - Effect of dislocation density
 - Effect of grain diameter
 - Subgrains and elongation factors

Database: mc_fe.tdb, mc_fe.ddb
Author: P. Warczok
Creation date: 10.11.2008
Last update: 13.06.2019 (P. Warczok, Update for 6.02)
This is a script for MatCalc version 6.02 (rel 1.003)

Known issues:
- "save-workspace "file-name"=Tutorial_16" is not working properly. --> Use "save-workspace Tutorial_16" instead.


**************************************************************************************************** 
************************************** SETUP INFORMATION *******************************************
**************************************************************************************************$$

use-module module-name=core                                                                                   $ Use "core" module (MatCalc uses "core" module by default anyway) 

read-workspace file-name=Tutorial_15                                                                          $ Load workspace from Tutorial 15


$$************************************************************************************************** 
**************************************** SYSTEM SETUP **********************************************
**************************************************************************************************$$


$$************************************************************************************************** 
                           SIMULTANEOUS PRECIPITATION WITH M23C6
**************************************************************************************************$$

create-new-phase parent-phase=M23C6 precipitate                                                               $ Creates M23C6 precipitate
set-precipitation-parameter precipitate-or-domain-name=M23C6_P0 number-of-size-classes=25                     $ Initializes M23C6 precipitate with 25 classes
set-precipitation-parameter precipitate-or-domain-name=M23C6_P0 nucleus-composition-model=ortho-composition   $ Ortho-composition for the M23C6 precipitate nuclei
$ Grain boundaries are nucleation sites for M23C6 precipitate
set-precipitation-parameter precipitate-or-domain-name=M23C6_P0 nucleation-sites=grain-boundaries 

$ Equilibrium dislocation density for ferrite domain set to 1e12 m-2
set-precipitation-parameter precipitate-or-domain-name=ferrite equilibrium-dislocation-density=1e12
set-gui-window-property window-id=2 remove-all-locked-plot-series                                             $ All locked series are [r]emoved from GUI-window no.3
set-gui-window-property window-id=. default-x-axis-scaling=1e-12..                                            $ Default x-axis scale starts at 1e-12
clear-calc-buffer buffer-name="_default_"                                                                     $ Calculation buffer is cleared
 
set-plot-option plot-id=1 series new buffer variable-name=F$M23C6_P0                                          $ Plotting fraction of M23C6 precipitate phase
set-plot-option plot-id=1 y-axis-title=Phase fraction                                                         $ y-axis title
set-plot-option plot-id=2 series remove series-index=1                                                        $ Removes series no.1 in plot #1
set-plot-option plot-id=2 series new buffer variable-name=X$BCC_A2$CR                                         $ Plotting Cr content in bcc phase
set-plot-option plot-id=4 series new buffer variable-name=NUM_PREC$M23C6_P0                                   $ Plotting the number of particles of M23C6 precipitate
set-plot-option plot-id=5 series new buffer variable-name=R_MEAN$M23C6_P0                                     $ Plotting mean radius of M23C6 precipitates
set-plot-option plot-id=1 series rename series-index=0 new-name="Cementite"                                   $ Renaming series in plot #0: #0 --> "Cementite"
$ Renaming series in plot #0: #1 --> "M<sub>23</sub>C<sub>6</sub>"
set-plot-option plot-id=1 series rename series-index=1 new-name="M<sub>23</sub>C<sub>6</sub>"
set-plot-option plot-id=2 series rename series-index=0 new-name="Cementite"                                   $ Renaming series in plot #1: #0 --> "Cementite"
set-plot-option plot-id=2 series rename series-index=1 new-name="Matrix (bcc_a2)"                             $ Renaming series in plot #1: #1 --> "Matrix (bcc_a2)"
$ Renaming series in plot #2: #0 --> "X<sub>BCC_A2,C</sub>"
set-plot-option plot-id=3 series rename series-index=0 new-name="X<sub>BCC_A2,C</sub>"
set-plot-option plot-id=4 series rename series-index=0 new-name="Cementite"                                   $ Renaming series in plot #3: #0 --> "Cementite"
$ Renaming series in plot #3: #1 --> "M<sub>23</sub>C<sub>6</sub>"
set-plot-option plot-id=4 series rename series-index=1 new-name="M<sub>23</sub>C<sub>6</sub>"
set-plot-option plot-id=5 series rename series-index=0 new-name="Cementite"                                   $ Renaming series in plot #4: #0 --> "Cementite"
$ Renaming series in plot #4: #1 --> "M<sub>23</sub>C<sub>6</sub>"
set-plot-option plot-id=5 series rename series-index=1 new-name="M<sub>23</sub>C<sub>6</sub>"

set-simulation-parameter end-time=3,6e10                                                                      $ End time - 3.6e10 seconds
set-simulation-parameter isothermal-temperature=600 
set-simulation-parameter temperature-in-C=yes                                                                 $ Temperature in Celsius
start-precipitate-simulation 


$$************************************************************************************************** 
                                 EFFECT OF DISLOCATION DENSITY
**************************************************************************************************$$

$ Renaming series in plot #0: #0 --> "Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=1 series rename series-index=0 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #0: #1 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=1 series rename series-index=1 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #1: #0 --> "Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=2 series rename series-index=0 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #1: #1 --> "Matrix (bcc_a2), 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=2 series rename series-index=1 new-name="Matrix (bcc_a2), 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #2: #0 --> "X<sub>BCC_A2,C</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=3 series rename series-index=0 new-name="X<sub>BCC_A2,C</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #3: #0 --> "Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=4 series rename series-index=0 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #3: #1 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=4 series rename series-index=1 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #4: #0 --> "Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=5 series rename series-index=0 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #4: #1 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=5 series rename series-index=1 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"

set-gui-window-property window-id=. duplicate-and-lock-plot-series        $ Locking all unlocked series
$ Renaming series in plot #0: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=1 series rename series-index=2 new-name="Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #0: #3 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=1 series rename series-index=3 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #1: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=2 series rename series-index=2 new-name="Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #1: #3 --> "Matrix (bcc_a2), 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=2 series rename series-index=3 new-name="Matrix (bcc_a2), 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #2: #1 --> "X<sub>BCC_A2,C</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=3 series rename series-index= 1 new-name="X<sub>BCC_A2,C</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #3: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=4 series rename series-index=2 new-name="Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #3: #3 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=4 series rename series-index=3 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #4: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=5 series rename series-index=2 new-name="Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
$ Renaming series in plot #4: #3 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=5 series rename series-index=3 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"

$ Dislocation density in ferrite domain set to 1e14 m-2
set-precipitation-parameter precipitate-or-domain-name=ferrite equilibrium-dislocation-density=1e14
start-precipitate-simulation


$$************************************************************************************************** 
                                    EFFECT OF GRAIN DIAMETER
**************************************************************************************************$$

$ Renaming series in plot #1: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=1 series rename series-index=2 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #1: #3 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
set-plot-option plot-id=1 series rename series-index=3 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #2: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=2 series rename series-index=2 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #2: #3 --> "Matrix (bcc_a2), 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
set-plot-option plot-id=2 series rename series-index=3 new-name="Matrix (bcc_a2), 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #3: #1 --> "X<sub>BCC_A2,C</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
set-plot-option plot-id=3 series rename series-index=1 new-name="X<sub>BCC_A2,C</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #4: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=4 series rename series-index=2 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #4: #3 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
set-plot-option plot-id=4 series rename series-index=3 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #5: #2 --> "Cementite, 10<sup>14</sup>m<sup>-2</sup>, 10<sup>-4</sup> m"
set-plot-option plot-id=5 series rename series-index=2 new-name="Cementite, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
$ Renaming series in plot #5: #3 --> "M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"
set-plot-option plot-id=5 series rename series-index=3 new-name="M<sub>23</sub>C<sub>6</sub>, 10<sup>12</sup>m<sup>-2</sup>, 10<sup>-5</sup> m"

$ Dislocation density in ferrite domain set to 1e12 m-2
set-precipitation-parameter precipitate-or-domain-name=ferrite equilibrium-dislocation-density=1e12
$ Initial grain diameter is set to 10e-6 m
set-precipitation-parameter precipitate-or-domain-name=ferrite initial-grain-diameter=10e-6 
start-precipitate-simulation 


$$************************************************************************************************** 
                                        SAVING WORKSPACE
**************************************************************************************************$$

$save-workspace "file-name"=Tutorial_16
save-workspace Tutorial_16