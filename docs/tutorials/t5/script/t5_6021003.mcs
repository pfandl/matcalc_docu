$$************************************************************************************************** 
************************************** GENERAL INFORMATION *****************************************
****************************************************************************************************

Script for MatCalc built-in variables and graphical output according to Tutorial 5.
The following contents will be covered:

 - Adding further plots to a plot window
 - Using the built-in variables
 - Defining a default x-axis
 - Modifying the series
 - Adding a new series to a plot
 - Removing a series from a plot
 - Duplicating and locking series
 - Editing series data
 - Converting series to tables

Database: mc_fe.tdb
Author: P. Warczok
Creation date: 20.03.2008
Last update: 10.05.2019 (P. Warczok, Update for 6.02)
This is a script for MatCalc version 6.02 (rel 1.003)

Known issues:
- "save-workspace "file-name"=Tutorial_5" is not working properly. --> Use "save-workspace Tutorial_5" instead.


**************************************************************************************************** 
************************************** SETUP INFORMATION *******************************************
**************************************************************************************************$$

use-module module-name=core                                         $ Use "core" module (MatCalc uses "core" module by default anyway) 

read-workspace file-name=Tutorial_4                                 $ Loads the workspace "Tutorial_4.mcw"



  

$$************************************************************************************************** 
                              ADDING PLOTS OF DIFFERENT VARIABLES
**************************************************************************************************$$

$ Creating new x-y plot in GUI-window no.2 (the number can read on the window bar)
create-new-plot plot-type=xy-plot attach-to-window=2 

$ For current ("." stands for "last used") plot a new series for buffer stored values of variable "dfm$*" is plotted
set-plot-option plot-id=. series new buffer variable-name=dfm$*


$-------------- Examples of other plots (every plot is plotted in a separate window) --------------$
create-new-plot plot-type=xy-plot attach-to-window=.                $ Creating new x-y plot in current GUI-window ("." stands for "last used")
set-plot-option plot-id=. series new buffer variable-name=gmp$*     $ "gmp$*" -Molar Gibbs energy of various phases

$ Chemical potential of carbon
create-new-plot plot-type=xy-plot attach-to-window=.                $ Creating new x-y plot in current GUI-window
set-plot-option plot-id=. series new buffer variable-name=mup$*$c   $ "mup$*$c" - Chemical potential of carbon in various phases

$ Molar heat capacity
create-new-plot plot-type=xy-plot attach-to-window=.
set-plot-option plot-id=. series new buffer variable-name=cpp$*     $ "cpp$*" - Molar heat capacity of various phases

$ Arranging plots in two columns
set-gui-window-property window-id=. number-of-plot-columns=2 

$------------------------------- Changing standard x-axis settings --------------------------------$
$ Default x-axis is to be used for all plots
set-gui-window-property window-id=. default-x-axis-for-all-plots=yes 
$ Temperature in °C will be shown on the default x-axis
set-gui-window-property window-id=. default-x-axis-data=t$c
$ Setting the title for the default x-axis
set-gui-window-property window-id=. default-x-axis-title=Temperature [°C]


$$************************************************************************************************** 
                                  MODIFYING THE SERIES IN PLOTS
**************************************************************************************************$$

$------------------------- Carbon concentration in the different phases ---------------------------$
create-new-plot plot-type=xy-plot attach-to-window=.
set-plot-option plot-id=. series new buffer variable-name=x$*$c	    $ "x$*$c" - mole fraction of C in various phases


$$ -------------- The modification of carbon concentration from mole fractions ---------------------
-------------- to weight percent - removing the old series and adding the new ones ---------------$$
$ Remove all series (all series meant with "*") in plot no.6	
set-plot-option plot-id=6 series remove *
$ Plot "x$*$c$wp" - weight percent of C in various phases
set-plot-option plot-id=. series new buffer variable-name=x$*$c$wp
$ Y-axis gets the title "Carbon content of phase [wt.%]"
set-plot-option plot-id=. y-axis-title=Carbon content of phase [wt.%]

$$************************************************************************************************** 
                                        SAVING WORKSPACE
**************************************************************************************************$$

$save-workspace "file-name"=Tutorial_5                              $ Saves workspace as "Tutorial_5.mcw"
save-workspace Tutorial_5 
