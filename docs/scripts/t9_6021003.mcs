set-step-option element=C                                                                       $ Carbon content varied 
set-step-option range start=0 stop=0,2 scale=lin step-width=0.0005                              $ Range 0 - 0,2; linear step of 0,0005
set-step-option element-content-in-wt%=yes                                                      $ Composition in wt.%
set-step-option temperature-in-celsius=yes                                                      $ Temperature in Celsius
set-step-option maximum-temperature-step=20                                                     $ Setting the ma(x). T-step to 20
step-equilibrium

set-gui-window-property window-id=. duplicate-and-lock-plot-series                              $ Locking all unlocked series
set-plot-option plot-id=. series rename series-index=-1 series-name=*_t$c new-name=bcc_high_2   $ Renaming series: "*_T$C" --> "bcc_high_2"


$---------------------------------- Boundary of NbC phase -----------------------------------------$
set-temperature-celsius temperature=1450                                                        $ Temperature 1450C
calculate-equilibrium
search-phase-boundary phase-name=FCC_A1#01 temperature                                          $ Varying temperature for the phase boundary search

set-step-option type=phase-boundary                                                             $ "Phase boundary" type
set-step-option scheil-dependent-phase=FCC_A1#01                                                $ Phase boundary of NbC phase field
set-step-option element=C                                                                       $ Carbon content varied
set-step-option range start=0 stop=0,2 scale=lin step-width=0.0005                              $ Range 0 - 0,2; linear step of 0,0005
set-step-option element-content-in-wt%=yes                                                      $ Composition in wt.%
set-step-option temperature-in-celsius=yes                                                      $ Temperature in Celsius
set-step-option maximum-temperature-step=100                                                    $ Setting the ma(x). T-step to 100
step-equilibrium

set-gui-window-property window-id=. duplicate-and-lock-plot-series                              $ Locking all unlocked series
set-plot-option plot-id=. series rename series-index=-1 series-name=*_t$c new-name=NbC          $ Renaming series: "*_T$C" --> "NbC"
set-plot-option plot-id=. y-axis-scaling=500..                                                  $ Scaling on the y-axis starts from 500


$------------------------------ Upper boundary of alpha-ferrite -----------------------------------$
set-temperature-celsius temperature=900                                                         $ Temperature 900C
calculate-equilibrium
search-phase-boundary phase-name=BCC_A2 temperature                                             $ Varying temperature for the phase boundary search

set-step-option type=phase-boundary                                                             $ "Phase boundary" type
set-step-option scheil-dependent-phase=BCC_A2                                                   $ Phase boundary of bcc phase field
set-step-option element=C                                                                       $ Carbon content varied
set-step-option range start=0 stop=0,2 scale=lin step-width=0.0005                              $ Range 0 - 0,2; linear step of 0,0005
set-step-option element-content-in-wt%=yes                                                      $ Composition in wt.%
set-step-option temperature-in-celsius=yes                                                      $ Temperature in Celsius
set-step-option maximum-temperature-step=20                                                     $ Setting the ma(x). T-step to 20
step-equilibrium

set-gui-window-property window-id=. duplicate-and-lock-plot-series                              $ Locking all unlocked series
set-plot-option plot-id=. series rename series-index=-1 series-name=*_t$c new-name=bcc_low      $ Renaming series: "*_T$C" --> "bcc_low"


$-------------------------------- Lower boundary of austenite -------------------------------------$
set-temperature-celsius temperature=700                                                         $ Temperature 700C
calculate-equilibrium
search-phase-boundary phase-name=FCC_A1 temperature                                             $ Varying temperature for the phase boundary search

set-step-option type=phase-boundary                                                             $ "Phase boundary" type
set-step-option scheil-dependent-phase=FCC_A1                                                   $ Phase boundary of fcc phase field
set-step-option element=C                                                                       $ Carbon content varied
set-step-option range start=0 stop=0,2 scale=lin step-width=0.0005                              $ Range 0 - 0,2; linear step of 0,0005
set-step-option element-content-in-wt%=yes                                                      $ Composition in wt.%
set-step-option temperature-in-celsius=yes                                                      $ Temperature in Celsius
set-step-option maximum-temperature-step=20                                                     $ Setting the ma(x). T-step to 20
step-equilibrium

set-gui-window-property window-id=. duplicate-and-lock-plot-series                              $ Locking all unlocked series
set-plot-option plot-id=. series rename series-index=-1 series-name=*_t$c new-name=fcc2         $ Renaming series: "*_T$C" --> "fcc2"


$------------------------------- Cementite upper phase boundary -----------------------------------$
set-temperature-celsius temperature=850                                                         $ Temperature 800C
calculate-equilibrium
search-phase-boundary phase-name=CEMENTITE temperature                                          $ Varying temperature for the phase boundary search



set-step-option type=phase-boundary                                                             $ "Phase boundary" type
set-step-option scheil-dependent-phase=CEMENTITE                                                $ Phase boundary of cementite phase field
set-step-option element=C                                                                       $ Carbon content varied
set-step-option range start=0 stop=0,2 scale=lin step-width=0.0005                              $ Range 0 - 0,2; linear step of 0,0005
set-step-option element-content-in-wt%=yes                                                      $ Composition in wt.%
set-step-option temperature-in-celsius=yes                                                      $ Temperature in Celsius
set-step-option maximum-temperature-step=20                                                     $ Setting the ma(x). T-step to 20
step-equilibrium

set-plot-option plot-id=. series lock series-index=-1 series-name=T$C do-lock=yes               $ Locking the last series
set-plot-option plot-id=. series rename series-index=-1 series-name=*_t$c new-name=cementite    $ Renaming series: "*_T$C" --> "cementite"


$----------------------------------- The finished diagram -----------------------------------------$
set-plot-option plot-id=. plot-title=Fe-C pseudobinary for 0.3 wt.% Nb                          $ Plot title
set-gui-window-property window-id=. default-x-axis-title=Carbon content [wt.%]                  $ x-axis title 
set-plot-option plot-id=. y-axis-title=Temperature [C]                                          $ y-axis title
set-plot-option plot-id=. legend-alignment=right                                                $ Legend on the right



